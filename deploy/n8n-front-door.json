{
  "id": "HTRFrontDoor0001",
  "name": "HTR front door (tony)",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "htr/webhooks/tony/tool",
        "responseMode": "responseNode",
        "options": {
          "rawBody": false
        }
      },
      "id": "wh-tool",
      "name": "Retell tool call",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        0,
        0
      ],
      "webhookId": "htr-tool"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "=http://htr-web:8000/webhooks/tony/tool",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "x-retell-secret",
              "value": "={{ $json.headers['x-retell-secret'] || '' }}"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify($json.body) }}",
        "options": {
          "timeout": 5000,
          "response": {
            "response": {
              "fullResponse": false,
              "neverError": true
            }
          }
        }
      },
      "id": "fw-tool",
      "name": "Forward tool call",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        260,
        0
      ]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ JSON.stringify($json) }}",
        "options": {}
      },
      "id": "rs-tool",
      "name": "Answer Retell (tool)",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [
        520,
        0
      ]
    },
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "htr/webhooks/tony/call-ended",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "wh-ended",
      "name": "Retell call ended",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        0,
        200
      ],
      "webhookId": "htr-call-ended"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "=http://htr-web:8000/webhooks/tony/call-ended",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "x-retell-secret",
              "value": "={{ $json.headers['x-retell-secret'] || '' }}"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify($json.body) }}",
        "options": {
          "timeout": 10000,
          "response": {
            "response": {
              "fullResponse": false,
              "neverError": true
            }
          }
        }
      },
      "id": "fw-ended",
      "name": "Forward call ended",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        260,
        200
      ]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ JSON.stringify($json) }}",
        "options": {}
      },
      "id": "rs-ended",
      "name": "Answer Retell (ended)",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [
        520,
        200
      ]
    },
    {
      "parameters": {
        "multipleMethods": true,
        "httpMethod": [
          "GET",
          "POST"
        ],
        "path": "htr/rule/:tenant/:pid/:verdict",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "wh-rule",
      "name": "Ruling button",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        0,
        400
      ],
      "webhookId": "htr-rule"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "=http://htr-web:8000/rulings/{{ $json.params.tenant }}/{{ $json.params.pid }}/{{ $json.params.verdict }}",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "t",
              "value": "={{ $json.query.t || '' }}"
            }
          ]
        },
        "options": {
          "timeout": 10000,
          "response": {
            "response": {
              "fullResponse": false,
              "neverError": true,
              "responseFormat": "text"
            }
          }
        }
      },
      "id": "fw-rule",
      "name": "Forward ruling",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        260,
        400
      ]
    },
    {
      "parameters": {
        "respondWith": "text",
        "responseBody": "={{ $json.data }}",
        "options": {
          "responseHeaders": {
            "entries": [
              {
                "name": "Content-Type",
                "value": "text/html; charset=utf-8"
              }
            ]
          }
        }
      },
      "id": "rs-rule",
      "name": "Answer the phone",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [
        520,
        400
      ]
    }
  ],
