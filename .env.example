# Copy to .env (never committed). One install, one file. Names match install.yaml's secrets block.

# --- the service ---------------------------------------------------------------
HTR_DATABASE_URL=sqlite:///htr.db                # postgres+psycopg://htr:...@postgres:5432/htr in production
HTR_TENANTS_FILE=install.yaml
HTR_DATA_DIR=./data                              # events.jsonl / rulings.jsonl live here (committed text)
HTR_PUBLIC_URL=https://n8n.felaniam.cloud/webhook/htr   # public base the vendors call; through n8n it is <n8n>/webhook/htr
HTR_RULING_URL=https://n8n.felaniam.cloud/webhook/htr/rule   # where the Send / Skip buttons point
HTR_RULING_SECRET=                               # signs the buttons; generate a long random string
HTR_OPERATOR_PHONE=                              # who gets paged when a heartbeat fails (us, not the client)

# --- Twilio (client-owned account) ---------------------------------------------
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=                               # validates inbound webhooks; can also send
TWILIO_API_KEY_SID=                              # restricted key, preferred for sending
TWILIO_API_KEY_SECRET=
TWILIO_FROM_NUMBER=                              # the number in install.yaml `numbers`

# --- Retell (client-owned account) ---------------------------------------------
RETELL_API_KEY=                                  # used by: python -m htr.provision.retell tony
HTR_TONY_RETELL_SECRET=                          # shared secret the agent sends in x-retell-secret

# --- LLM (only if adapters.llm is openai_compat) --------------------------------
HTR_LLM_BASE_URL=                                # e.g. https://omniroute.felaniam.cloud/v1
HTR_LLM_API_KEY=
HTR_LLM_MODEL=

# --- ntfy (optional, owner push without SMS) -----------------------------------
HTR_NTFY_URL=https://ntfy.sh
HTR_NTFY_TOPIC=                                  # a name you invent; subscribe to it in the ntfy app
HTR_NTFY_TOKEN=                                  # optional, for a protected topic
POSTGRES_PASSWORD=                               # compose only
